<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Stage 2a: Microsoft/runtime packages only. No SIPSorcery/WebRTC restores. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Lab: MAUI Android pulls Xamarin/Google transitive packages; keep a single public source. -->
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
